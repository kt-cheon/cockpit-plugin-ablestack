{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "paths": { "cockpit": ["./src/platform/cockpit.ts"] }
  },
  "include": ["src/main.tsx", "src/platform/*.d.ts"]
}
